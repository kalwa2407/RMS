{
  "hosting": {
    "public": "frontend/build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.mp4",
      "**/*.mov",
      "**/*.avi"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "tasteofhindustan-api",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
