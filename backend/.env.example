# ==============================================================================
# Persian Darbar RMS - Environment Variables Example
# ==============================================================================

# Database Configuration
DATABASE_URL=
DB_MODE=FIREBASE
FIREBASE_STORAGE_BUCKET=

# Restaurant Details
RESTAURANT_NAME=Persian Darbar
RESTAURANT_PHONE=9594287868
RESTAURANT_ADDRESS=Camp, Pune
RESTAURANT_LAT=18.5126
RESTAURANT_LNG=73.8785

# External Integrations
OPENAI_API_KEY=
PORTER_API_KEY=
PORTER_API_BASE_URL=
PORTER_WEBHOOK_SECRET=

# ==============================================================================
# Meta WhatsApp Cloud API Configuration
# ==============================================================================
# Permanent / System User Access Token from Meta Business Manager
# NEVER commit or hardcode this token!
WHATSAPP_ACCESS_TOKEN=

# WhatsApp Business Account ID (WABA)
WHATSAPP_BUSINESS_ACCOUNT_ID=207051877129638

# Production WhatsApp Phone Number ID for +91 95942 87868
WHATSAPP_PHONE_NUMBER_ID=2681861995237690

# Custom verification secret you define in Meta App Dashboard under Webhooks
# Example: PD_RMS_WA_2026_VERIFY_7xQ91
WHATSAPP_VERIFY_TOKEN=

# Meta Graph API Version (Recommended: v20.0 or v21.0)
WHATSAPP_API_VERSION=v20.0

# Public Production Webhook Endpoint (HTTPS required by Meta)
# E.g.: https://tasteofhindustan-api-63332283509.asia-south1.run.app/api/whatsapp/webhook
WHATSAPP_WEBHOOK_URL=https://tasteofhindustan-api-63332283509.asia-south1.run.app/api/whatsapp/webhook

# Meta App Secret from App Settings -> Basic (Used to verify X-Hub-Signature-256)
META_APP_SECRET=

# Optional: Approved Meta Template Name for Reservation Confirmation (e.g. reservation_confirmed)
WHATSAPP_RESERVATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
